# Groq API key for llama-3.3-70b-versatile (via OpenAI-compatible SDK)
GROQ_API_KEY=

# Neon Postgres connection strings (auto-injected by Vercel Storage)
# DATABASE_URL: pooled, for runtime queries
# DATABASE_URL_UNPOOLED: persistent, for migrations / seed scripts
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Random string used to sign the demo auth cookie (legacy, may be removed)
SESSION_SECRET=

# JWT signing secret for the session cookie. Must be 32+ chars.
JWT_SECRET=changeme

# Base URL used to build verification / password-reset links in emails.
APP_URL=http://localhost:3000

# Gmail account + App Password (not your normal password — generate one at
# https://myaccount.google.com/apppasswords) used to send verification and
# password-reset emails via nodemailer.
GMAIL_USER=
GMAIL_APP_PASSWORD=
